## Create a deseq object
```{r include=FALSE}

#cleaning up the metadata
data_mat <- round(data_mat)
meta$Condition <- as.factor(meta$Condition)
meta$Condition <- relevel(factor(meta$Condition), ref = "DMSO") #set DMSO as reference for all comparisons

# Remove the last row, (named NA.), contains all reads that were not mapped to hugo, summed up
data_mat <- data_mat[-nrow(data_mat), ]

#deseq2 function
dds <- DESeqDataSetFromMatrix(countData = data_mat, 
                              colData = meta, 
                              design = ~ Condition)
# Run DESeq
dds <- DESeq(dds)


rm(data_mat)

# Here I am creating a table for GSEA based on deseq2 results. Keeping ensembl versions after GSEA procedure, and adding hugo for readability/interpretability.

normalized_counts <- counts(dds, normalized = TRUE)
normalized_counts <- as.data.frame(normalized_counts)
normalized_counts$gene_id <- rownames(normalized_counts)
rownames(normalized_counts) <- NULL
gtf_data <- as.data.frame(gtf_data)
#Add gene names
gene_mapping <- gtf_data %>%
  filter(type == "gene") %>%  # Keep only rows corresponding to genes
  dplyr::select(gene_id, gene_name) %>%  # Extract `gene_id` and `gene_name` columns
  distinct()  # Ensure unique mappings
# Remove version numbers from `Name` column in filtered_sf
gene_mapping$gene_id <- gsub("\\.\\d+$", "", gene_mapping$gene_id)
normalized_counts$gene_id <- gsub("\\.\\d+$", "", normalized_counts$gene_id)

normalized_counts <- normalized_counts %>%
  left_join(gene_mapping, by = "gene_id")
#save the table
write.table(normalized_counts,file="normalized_counts_CERITINIB-JAN14.txt",sep="\t",row.names=F,col.names=T,quote=F)
