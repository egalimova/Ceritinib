```{r}
sf_list <- list()

# Process each .sf file
for (file in sf_files) {
  sample_name <- gsub(".sf$", "", basename(file))
  
  # Read the .sf file
  sf_data <- read.delim(file, header = TRUE)
  
  # Keep only the relevant columns (NumReads for raw read counts)
  sf_data <- sf_data %>%
    dplyr::select(Name, NumReads) %>%
    rename_with(~sample_name, .cols = "NumReads")
  
  # Add the data frame to the list
  sf_list[[sample_name]] <- sf_data
}


# Merge all data frames by the 'Name' column
data <- Reduce(function(x, y) merge(x, y, by = "Name", all = TRUE), sf_list)


#file containing gene annotation, gownloaded from gencode
