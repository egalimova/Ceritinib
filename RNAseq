```{r}
#transcrip id to gene id, then filter out lowly expressed gene counts
# Create a transcript-to-gene mapping table
transcript_to_gene <- gtf_df %>%
  filter(!is.na(transcript_id)) %>% 
  dplyr::select(transcript_id, gene_id)    # Keep only transcript_id and gene_id

# Standardize transcript IDs by removing version numbers
data$Name <- gsub("\\.\\d+$", "", data$Name)
transcript_to_gene$transcript_id <- gsub("\\.\\d+$", "", transcript_to_gene$transcript_id)

# Join data and transcript_to_gene
mapped_counts <- data %>%
  left_join(transcript_to_gene, by = c("Name" = "transcript_id"))

# Aggregate counts at the gene level
# Group by gene_id and sum counts across all transcripts
gene_level_counts <- mapped_counts %>%
  group_by(gene_id) %>%
  summarise(across(-Name, sum, na.rm = TRUE))

# Convert back to data frame
gene_level_counts <- as.data.frame(gene_level_counts)
rm(data)
rm(mapped_counts)
# Filter lowly expressed genes
# Define a threshold for filtering (5 because it is commonly used, but on a more conservative side.)
filtered_gene_counts <- gene_level_counts %>%
  filter(rowSums(across(where(is.numeric))) >= 5)

data <- filtered_gene_counts
rm(filtered_gene_counts)
rm(gene_level_counts)
```

