```{r}
#Genes that are common to all, with consistent modulation!

#Find common genes across all three lists
common_genes <- Reduce(intersect, list(df.out.ce.sig$gene_id, df.out.yb.sig$gene_id, df.out.su.sig$gene_id))

#Filter for common genes in each dataset
common_ce <- df.out.ce.sig %>% filter(gene_id %in% common_genes)
common_yb <- df.out.yb.sig %>% filter(gene_id %in% common_genes)
common_su <- df.out.su.sig %>% filter(gene_id %in% common_genes)

#Merge the filtered datasets for comparison
merged_common <- common_ce %>%
  dplyr::select(gene_id,gene_name, log2FoldChange_ce = log2FoldChange) %>%
  left_join(
    common_yb %>% dplyr::select(gene_id, log2FoldChange_yb = log2FoldChange),
    by = "gene_id"
  ) %>%
  left_join(
    common_su %>% dplyr::select(gene_id, log2FoldChange_su = log2FoldChange),
    by = "gene_id"
  )

# Filter for consistent modulation direction (same LFC sign)
# Ensure all LFCs are positive or all negative
consistent_genes <- merged_common %>%
  filter(
    (log2FoldChange_ce > 0 & log2FoldChange_yb > 0 & log2FoldChange_su > 0) |
    (log2FoldChange_ce < 0 & log2FoldChange_yb < 0 & log2FoldChange_su < 0)
  )

# Save the consistent genes
write.table(
  consistent_genes,
  file = "consistent_modulated_genes_dec18.txt",
  sep = "\t",
  row.names = FALSE,
  col.names = TRUE,
  quote = FALSE
)

#View the final list
head(consistent_genes)

