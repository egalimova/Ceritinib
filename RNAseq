## Differentially expressed genes between conditions
```{r echo=FALSE}
#emove results for ceritinib to a separate df
res_CE <- results(dds, contrast = c("Condition", "CE", "DMSO"), alpha = 0.05)
#perform LFC shrinkage
res_CE <- lfcShrink(dds, coef = "Condition_CE_vs_DMSO", type = "apeglm")
summary(res_CE)

res_SU <- results(dds, contrast = c("Condition", "SU056", "DMSO"), alpha = 0.05)
res_SU <- lfcShrink(dds, coef = "Condition_SU056_vs_DMSO", type = "apeglm")
summary(res_SU)

res_YB <- results(dds, contrast = c("Condition", "YB1", "DMSO"), alpha = 0.05)
res_YB <- lfcShrink(dds, coef = "Condition_YB1_vs_DMSO", type = "apeglm")
summary(res_YB)
```


```{r include=FALSE}
#full DEG lists for different conditions
